# Copy this file to worker/.env and fill in the values. Git ignores worker/.env.
# Never commit a real token.

# Cloudflare account ID: dashboard, Workers & Pages, right-hand side.
CLOUDFLARE_ACCOUNT_ID=

# Account API token (not a user token).
# Dashboard: Manage account > Account API tokens > Create Token. Set an end date.
# Permissions:
#   Account > Workers Scripts > Edit
#   Account > D1 > Edit
#   Account > Account Settings > Read
CLOUDFLARE_API_TOKEN=

# Organiser code that the Worker requires to make a new poll. Choose a long random string.
CREATE_CODE=
