{
  "name": "quick-vote",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/irv.test.mjs test/seo.test.mjs",
    "db:local": "cd worker && wrangler d1 execute quick-vote --local --file=schema.sql",
    "dev:worker": "cd worker && wrangler dev --local --ip 0.0.0.0",
    "dev:site": "python3 -m http.server 8000",
    "test:browser": "node test/browser/run-all.mjs",
    "test:all": "npm test && npm run test:browser"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "wrangler": "^4"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
